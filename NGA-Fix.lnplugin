#!name=NGA图片域名修复
#!desc=修复NGA论坛助手因 imgN.nga.178.com 系列域名失效导致图片无法加载的问题，统一重定向到 imgN.nga.cn
#!author=Ka1er
#!version=2.1.0

[Rewrite]
# img.nga.178.com  -> img.nga.cn
# img4.nga.178.com -> img4.nga.cn   (\d* 捕获可选的数字后缀)
^https?:\/\/img(\d*)\.nga\.178\.com\/(.*) https://img$1.nga.cn/$2 header

[MITM]
hostname = img*.nga.178.com
